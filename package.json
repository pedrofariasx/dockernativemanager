{
  "name": "docker-native-manager",
  "version": "1.19.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm prepare:monaco && vite",
    "build": "pnpm prepare:monaco && vite build",
    "build:dev": "pnpm prepare:monaco && vite build --mode development",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "format": "prettier --write \"src/**/*.{ts,tsx,json,css,md}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,json,css,md}\"",
    "preview": "vite preview",
    "tauri": "tauri",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "prepare": "husky",
    "prepare:monaco": "node scripts/prepare-monaco.js"
  },
